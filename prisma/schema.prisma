// HexaConverter — data model
// Provider: PostgreSQL 14+
//
// The service is free and asks for nothing about the person using it. Anything
// a conversion needs in order to exist at all — the job, the upload it came
// from, the objects on disk — is transient and swept by the retention pass, and
// belongs to an opaque per-browser cookie that names nobody.
//
// `User` is the one exception, and is strictly opt-in: it exists only for
// someone who chose to sign in, holds no credentials, and is not required to
// convert a file. Everything else in this schema works with it absent.

generator client {
  provider = "prisma-client-js"

  // `native` is the machine running `prisma generate`; the Debian target is the
  // deployment. Both are emitted so a build produced on a developer's Mac still
  // carries a query engine the Linux server can load — without it the client
  // throws on the first query with a message about a missing engine, which
  // reads like a database fault rather than a packaging one.
  //
  // `debian-openssl-3.0.x` covers Ubuntu 22.04/24.04 and Debian 12. Alpine
  // needs `linux-musl-openssl-3.0.x` instead.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"

  // Runtime connections go through a transaction-mode pooler. Prisma opens a
  // connection per query here, which is what the pooler is for.
  url = env("DATABASE_URL")

  // Migrations bypass it. DDL and advisory locks need one stable session for
  // the whole run, and a transaction pooler hands each statement whichever
  // backend is free. Falls back to `url` when unset, so a plain unpooled
  // Postgres needs no extra configuration.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Conversion pipeline
// ---------------------------------------------------------------------------

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

/// Document operations that are not a plain format-to-format conversion.
enum DocumentOperation {
  MERGE
  SPLIT
  EXTRACT_PAGES
  ROTATE
  COMPRESS
  OCR
}

/// Archive operations that are not a plain format-to-format conversion.
enum ArchiveOperation {
  EXTRACT
  ARCHIVE
  PROTECT
}

enum FileCategory {
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  ARCHIVE
}

/// A resumable, chunked upload in progress.
///
/// Large files are sent in pieces so a dropped connection costs one chunk
/// rather than the whole transfer. Each chunk is stored as its own object and
/// the pieces are streamed together when the client says the upload is done.
model UploadSession {
  id String @id @default(cuid())

  /// Opaque per-browser id from the guest cookie. It names no person and is
  /// joined to nothing; it exists so a session id leaked to someone else is
  /// still unusable.
  guestId String

  filename     String
  sourceFormat String
  mime         String
  /// Total byte length the client declared up front.
  declaredSize BigInt
  /// Bytes actually stored so far, summed across received chunks.
  receivedSize BigInt @default(0)

  chunkSize      Int
  totalChunks    Int
  /// Indices already stored. Re-sending a chunk is idempotent.
  receivedChunks Int[] @default([])

  /// Prefix the chunk objects live under, e.g. `uploads/<id>`.
  storagePrefix String

  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Abandoned sessions are swept after this instant.
  expiresAt DateTime

  @@index([guestId])
  @@index([expiresAt])
}

model ConversionJob {
  id String @id @default(cuid())

  /// Owning browser, from the guest cookie. Anonymous conversions stay private
  /// from one another without anyone having to identify themselves.
  guestId String

  /// Set only once a signed-in person owns this conversion, either because they
  /// were signed in when they started it or because they signed in afterwards
  /// and it was claimed from this browser. Null is the ordinary case.
  ///
  /// `SetNull` on delete rather than cascade: closing an account should not
  /// destroy work that is still in flight or still downloadable. The row falls
  /// back to being owned by the browser alone and expires on its own schedule,
  /// which is exactly where it started.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status   JobStatus    @default(QUEUED)
  category FileCategory

  sourceFormat String
  targetFormat String
  // Validated, engine-specific options (quality, resolution, bitrate, ...).
  options      Json?

  /// Set for toolkit jobs (merge, split, ...); null for format conversions.
  operation DocumentOperation?

  /// Set for archive-toolkit jobs (extract, archive, protect).
  archiveOperation ArchiveOperation?

  progress Int     @default(0)
  error    String? @db.Text
  attempts Int     @default(0)

  inputKey  String
  inputName String
  inputSize BigInt
  inputMime String

  /// Additional inputs for operations that take several files, such as merge.
  /// The primary input above is always the first in order.
  extraInputKeys  String[] @default([])
  extraInputNames String[] @default([])

  outputKey    String?
  outputName   String?
  outputSize   BigInt?
  /// Engine-reported summary of what the job produced, shown to the user.
  outputDetail String?
  outputMime   String?

  // Optimistic worker lease — prevents two instances claiming the same job.
  lockedAt DateTime?
  lockedBy String?

  durationMs Int?
  /// Salted digest of the client address, for abuse control only. The address
  /// itself is never stored and the digest is not reversible.
  ipHash     String?

  expiresAt  DateTime
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([guestId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  ipHash    String?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

/// What an account is entitled to. `ANONYMOUS` is not stored on anyone — a
/// visitor without an account has no row at all — but it is named here so the
/// enum matches the tiers in `src/lib/plans.ts` and nothing has to translate
/// between two vocabularies.
enum PlanTier {
  ANONYMOUS
  FREE
  PREMIUM
}

/// A person who chose to sign in. Accounts are strictly opt-in: conversion
/// stays anonymous and free without one, and nothing here is required to use
/// the service.
///
/// Credentials are deliberately absent. Firebase Authentication holds the
/// password, hashes it, and handles reset, verification and any second factor,
/// so this table never sees one — a breach of this database exposes no way to
/// sign in as anybody. What is stored is the minimum needed to attach work and
/// a subscription to a person: the Firebase UID to join on, and a cached copy
/// of the profile so ordinary pages do not have to call Google to render a
/// name.
///
/// The cached fields go stale if the profile changes elsewhere; they are
/// refreshed on sign-in, and the Firebase record remains the source of truth.
/// Deleting an account has to remove the Firebase user *and* this row —
/// removing one and leaving the other is the failure mode to watch for.
model User {
  id String @id @default(cuid())

  /// Firebase Authentication UID. The join key for everything this person owns,
  /// and stable across email or provider changes — which is why rows key on it
  /// rather than on the address.
  firebaseUid String @unique

  /// Cached from the Firebase profile. Unique because the project is configured
  /// to allow one account per address; drop the constraint if that is ever
  /// relaxed to let a person hold separate password and Google identities.
  email         String  @unique
  emailVerified Boolean @default(false)
  displayName   String?

  /// Cached from the sign-in provider — Google supplies one, email/password
  /// does not. Refreshed from the token on every sign-in, so it must never
  /// hold anything the person chose themselves.
  photoUrl      String?

  /// Storage key for a picture the person uploaded, which wins over
  /// `photoUrl`. Kept in its own column precisely because the sync above
  /// overwrites `photoUrl` on every sign-in and would erase their choice.
  avatarKey     String?

  /// Current entitlement. Set to `PREMIUM` by a completed purchase, and back to
  /// `FREE` when one lapses; until billing exists it is only ever changed by
  /// hand. Never `ANONYMOUS` — an account is by definition not anonymous.
  planTier PlanTier @default(FREE)

  /// When the current premium term ends. Null on a free account. Read as the
  /// authority on whether premium is still live, so a lapsed subscription
  /// degrades on its own even if nothing has processed the expiry yet.
  premiumUntil DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Last time a session was established, for dormant-account cleanup.
  lastSeenAt DateTime?

  /// Conversions this person owns. Claimed from the browser on sign-in, so
  /// history survives changing device or clearing cookies.
  conversions ConversionJob[]

  subscriptions Subscription[]

  @@index([email])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

/// The billing record behind a premium account.
///
/// Kept separate from `User.planTier` on purpose. The tier is what the service
/// enforces right now; this is the history of why — what was bought, when, for
/// how much, and what Paddle currently thinks of it. Collapsing the two would
/// mean a refund dispute or a failed renewal had nowhere to be recorded.
///
/// Paddle is the merchant of record, so no card detail, address or tax figure
/// is ever stored here — only the identifiers needed to reconcile an account
/// with a transaction on Paddle's side.
model Subscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Paddle's own subscription id (`sub_...`). Unique because one Paddle
  /// subscription must never map to two rows — it is the key incoming webhooks
  /// are matched on.
  paddleSubscriptionId String  @unique
  paddleCustomerId     String?
  /// The price that was bought (`pri_...`), kept so a later price change does
  /// not rewrite what this person actually agreed to.
  paddlePriceId        String?

  status SubscriptionStatus @default(ACTIVE)

  /// End of the paid term. Copied onto `User.premiumUntil`, which is what the
  /// entitlement check actually reads.
  currentPeriodEnd DateTime?
  /// Set when a cancellation is scheduled; access continues until the term ends.
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// Every webhook Paddle has delivered, by its own event id.
///
/// Paddle retries until it gets a 200, and a retry of "subscription activated"
/// must not extend somebody's term a second time. Recording the id before
/// acting, and refusing to act twice on the same one, is what makes these
/// handlers idempotent — the alternative is an outage turning into free months.
model ProcessedWebhook {
  /// Paddle's `event_id` (`evt_...`).
  eventId    String   @id
  eventType  String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}
