# HexaConverter — production environment
#
#   cp .env.production.example .env.production
#
# `.env.production` is git-ignored. Do not commit it, and do not paste its
# contents into a chat, an issue or a CI log.
#
# Generate all three secrets fresh for every environment — never reuse the
# development values:
#   openssl rand -base64 32   -> NEXTAUTH_SECRET
#   openssl rand -hex 32      -> DOWNLOAD_URL_SECRET
#   openssl rand -hex 32      -> CRON_SECRET
#
# Every variable is validated at startup by src/lib/env.ts. A missing or
# malformed value fails the boot with a specific message rather than causing
# something odd later, so an empty required field here is a fast, loud failure.

NODE_ENV=production

# --- Public identity --------------------------------------------------------
# Inlined into the client bundle at build time, so these must be correct
# *before* the image is built. They drive canonical URLs, OG tags, the sitemap
# and the links in outbound email.
NEXT_PUBLIC_APP_URL=https://hexaconverter.app
NEXT_PUBLIC_APP_NAME=HexaConverter

# --- Image ------------------------------------------------------------------
# Read by docker-compose.prod.yml. Pin a digest rather than a tag so a rollback
# is exact and `latest` cannot move under you.
IMAGE=ghcr.io/OWNER/hexaconverter@sha256:REPLACE_WITH_DIGEST

# --- Database ---------------------------------------------------------------
# Managed Postgres is strongly preferred: see docs/BACKUP.md for why owning
# this yourself is a bigger commitment than it looks.
#
# Passwords containing % + / @ : or ? must be percent-encoded, or the URL will
# not parse and the failure looks exactly like a wrong password:
#   node -e 'console.log(encodeURIComponent(process.argv[1]))' 'PASSWORD'
DATABASE_URL=postgresql://user:password@host:5432/hexaconverter?schema=public&sslmode=require

# Must always be set — `directUrl` in schema.prisma references it and Prisma
# fails validation if it is missing, rather than falling back to DATABASE_URL.
# For a direct database, use the same value as DATABASE_URL. It differs only
# when DATABASE_URL is a transaction-mode pooler, which cannot hold the stable
# session that migrations need; then use the session-mode or direct endpoint.
DIRECT_URL=postgresql://user:password@host:5432/hexaconverter?schema=public&sslmode=require

# --- Authentication ---------------------------------------------------------
NEXTAUTH_URL=https://hexaconverter.app
NEXTAUTH_SECRET=

# Optional. Leave blank and the provider is hidden from the sign-in UI.
# Callback URLs to register with each provider:
#   https://hexaconverter.app/api/auth/callback/google
#   https://hexaconverter.app/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Refuses password sign-in until the address is confirmed. Startup rejects
# `true` without SMTP_HOST — with no way to send the link, no new account could
# ever sign in.
REQUIRE_EMAIL_VERIFICATION=true

# --- Signing ----------------------------------------------------------------
# HMAC key for download links and upload tickets. Rotating it invalidates every
# outstanding download URL, which is a safe thing to do and occasionally the
# right response to a leak.
DOWNLOAD_URL_SECRET=

# --- Storage ----------------------------------------------------------------
# `s3` for anything with more than one instance. The production build refuses
# `local` unless ALLOW_LOCAL_STORAGE_IN_PRODUCTION is set, because a local
# directory is not shared between replicas — a job written by one instance is
# invisible to the next.
STORAGE_DRIVER=s3

S3_REGION=eu-west-1
S3_BUCKET=hexaconverter-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for S3-compatible providers (R2, MinIO, Spaces); leave blank for AWS.
S3_ENDPOINT=
# MinIO and some others need path-style addressing.
S3_FORCE_PATH_STYLE=false

# Single node with a persistent volume only. Never with a replica count above 1.
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
# STORAGE_LOCAL_DIR=/var/lib/hexaconverter/storage

# --- Limits -----------------------------------------------------------------
# Must not exceed what the reverse proxy accepts. Nginx's client_max_body_size
# rejects before the request reaches the app, so a mismatch surfaces as an
# unexplained 413. Both default to 512 MB.
MAX_UPLOAD_BYTES=536870912
FILE_RETENTION_HOURS=168

# --- Worker -----------------------------------------------------------------
# Set per service, not globally: the web tier runs with WORKER_ENABLED=false and
# the worker with true. docker-compose.prod.yml overrides both, so the value
# here is only the fallback for a single-process deployment.
WORKER_ENABLED=true
# Per replica. Total parallel encodes is this times the replica count; keep the
# product at or below the host's core count.
WORKER_CONCURRENCY=2

# --- Conversion tooling -----------------------------------------------------
# Leave unset in Docker: the image installs these and they resolve on PATH.
# Set them only when running on a host where they are somewhere unusual.
# Routes whose tooling is missing are reported unavailable by /api/formats and
# refused at job creation, rather than failing halfway through a conversion.
FFMPEG_PATH=
FFPROBE_PATH=
SOFFICE_PATH=
SEVEN_ZIP_PATH=

# --- Malware scanning -------------------------------------------------------
# Leaving CLAMAV_HOST unset disables scanning, which /api/health then reports
# as `degraded` rather than implying files are checked when they are not.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000

# --- Scheduled work --------------------------------------------------------
# Bearer token for /api/cron/*. On Vercel, naming it exactly CRON_SECRET makes
# the platform send it automatically on scheduled invocations.
CRON_SECRET=

# --- Email ------------------------------------------------------------------
# Carries password resets and email confirmations as well as contact messages.
# Without SMTP_HOST, account recovery by email is unavailable and
# REQUIRE_EMAIL_VERIFICATION must be false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@hexaconverter.app
CONTACT_INBOX=support@hexaconverter.app
