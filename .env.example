# ---------------------------------------------------------------------------
# HexaConverter — environment configuration
# Copy to `.env` for local development and set real values in your host's
# secret manager for production. Never commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
NODE_ENV=development
# Public origin of the deployment. Used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HexaConverter

# --- Database -------------------------------------------------------------
# PostgreSQL 14+. Add `?sslmode=require` for managed providers.
DATABASE_URL=postgresql://hexa:hexa@localhost:5432/hexaconverter?schema=public

# The connection migrations run over. It must always be set: `directUrl` in
# schema.prisma references it, and Prisma fails validation outright if the
# variable is missing — it does not fall back to DATABASE_URL.
#
# For a direct (unpooled) database, make it identical to DATABASE_URL. It only
# differs when DATABASE_URL points at a transaction-mode pooler (Supabase,
# PgBouncer, Neon pooled), which cannot hold the single stable session that DDL
# and advisory locks need; then this is the session-mode or direct endpoint.
#
# Passwords with reserved characters (% + / @ : ?) must be percent-encoded, or
# the URL will not parse and the failure looks like a wrong password:
#   node -e 'console.log(encodeURIComponent(process.argv[1]))' 'PASSWORD'
DIRECT_URL=postgresql://hexa:hexa@localhost:5432/hexaconverter?schema=public

# --- Signed download URLs -------------------------------------------------
# Separate secret used to sign short-lived download links.
# Generate with: openssl rand -hex 32
DOWNLOAD_URL_SECRET=replace-with-openssl-rand-hex-32

# --- Storage --------------------------------------------------------------
# `local` writes to STORAGE_LOCAL_DIR (development only).
# `s3` targets any S3-compatible service (AWS S3, Cloudflare R2, MinIO, Wasabi).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Required to run the local driver with NODE_ENV=production. Only appropriate
# for a single instance backed by a persistent volume.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for non-AWS S3-compatible providers, e.g.
# https://<account>.r2.cloudflarestorage.com or http://localhost:9000
S3_ENDPOINT=
# Path-style addressing is required by MinIO and some R2 setups.
S3_FORCE_PATH_STYLE=false

# --- Conversion limits ----------------------------------------------------
# Hard ceiling applied before any plan limit (bytes). Must be at least the
# largest plan's maxFileBytes in src/lib/plans.ts, or Premium is advertised
# 2 GB and refused at this value instead. Default 2 GB.
MAX_UPLOAD_BYTES=2147483648
# Global ceiling on file retention, in hours. The effective retention is the
# lower of this and LIMITS.retentionHours in src/lib/plans.ts.
FILE_RETENTION_HOURS=168
# Concurrent conversions per application instance.
WORKER_CONCURRENCY=2
# Set to `false` on instances that should only serve HTTP traffic
# (when conversions are driven exclusively by the cron endpoint).
WORKER_ENABLED=true

# --- External binaries ----------------------------------------------------
# ffmpeg/ffprobe resolve from the bundled static builds unless overridden.
FFMPEG_PATH=
FFPROBE_PATH=
# LibreOffice headless binary, required for Office document conversions.
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Linux: /usr/bin/soffice
SOFFICE_PATH=
# 7-Zip binary. Resolves from the bundled `7zip-bin` package unless overridden;
# needed for password-protected archives.
SEVEN_ZIP_PATH=
# Poppler and Ghostscript are discovered on PATH. Poppler powers PDF-to-image
# and PDF-to-text; Ghostscript improves PDF compression. Both are optional —
# routes that need them report as unavailable, and compression degrades to a
# lossless rewrite. Install with:
#   macOS  brew install poppler ghostscript
#   Debian apt-get install poppler-utils ghostscript

# --- Cron / scheduled tasks ----------------------------------------------
# Bearer token required by /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-openssl-rand-hex-32

# --- Email (contact form) -------------------------------------------------
# The only mail the service sends. Leave SMTP_HOST empty to persist contact
# messages to the database without delivering them, which is what you want
# locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@hexaconverter.com
CONTACT_INBOX=info@hexaconverter.com

# --- Accounts (Firebase Authentication) -----------------------------------
# Optional. Leave the whole block empty and the site runs exactly as it does
# today: anonymous, free, no sign-in shown anywhere. Accounts are additive.
#
# The four NEXT_PUBLIC_ values come from the Firebase console under
# Project settings > General > Your apps > SDK setup and configuration. They
# are public by design — compiled into the client bundle and readable by
# anyone. Security comes from the authorised-domain list in the console and
# from verifying every token server-side, not from hiding these.
#
# They are inlined at BUILD time. Changing one needs a rebuild, not a restart.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The service account, from Project settings > Service accounts > Generate new
# private key. This one IS a secret: it can impersonate any user and bypasses
# every rule. Runtime-only, `chmod 600`, never committed.
#
# The private key is multi-line PEM. Wrap it in double quotes and keep the
# newlines as literal \n — the code converts them back. Pasting the raw
# multi-line block instead is the usual cause of "Failed to parse private key".
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Payments (Paddle) ----------------------------------------------------
# Optional. Leave empty and the pricing page shows Premium as unavailable
# rather than offering a checkout that cannot complete.
#
# Paddle is the merchant of record: it collects payment and remits the correct
# sales tax in every country it sells to, so no VAT registration or filing
# happens here.
#
# `sandbox` is Paddle's test environment. The client token is public by design
# — it is compiled into the browser bundle and can only open a checkout. A
# `test_` prefix means sandbox, `live_` means production. Both NEXT_PUBLIC_
# values are inlined at BUILD time, so changing one needs a rebuild.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=

# Genuinely secret, runtime-only. The API key can read and refund every
# transaction; the webhook secret is what distinguishes a real Paddle event
# from anyone who discovered the endpoint. `chmod 600`, never committed.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- Malware scanning -----------------------------------------------------
# Scanning is delegated to a ClamAV daemon. Leaving CLAMAV_HOST unset disables
# it entirely, which /api/health reports as `degraded` rather than implying
# uploads are checked when they are not.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
